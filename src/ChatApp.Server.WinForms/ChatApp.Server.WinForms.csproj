<Project Sdk="Microsoft.NET.Sdk">

  <!-- ChatServer.exe: sunucu penceresi. Butun is mantigi ChatApp.Server kutuphanesinde;
       burada sadece pencere, log dosyasi, DPAPI ve siniflarin birbirine baglanmasi (DI) var. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ChatServer</AssemblyName>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatApp.Protocol\ChatApp.Protocol.csproj" />
    <ProjectReference Include="..\ChatApp.Server\ChatApp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
